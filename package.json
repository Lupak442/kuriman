{
  "name": "kurimanju-shimeji-timer",
  "version": "1.0.5",
  "description": "Chiikawa Kurimanju Desktop Shimeji with Timer & Bag Bookmark Launcher",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.kurimanju.shimeji",
    "productName": "먼작귀 시메지",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lupak442",
        "repo": "kuriman",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "먼작귀 시메지",
      "artifactName": "Kurimanju-Shimeji-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Kurimanju-Shimeji-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "scripts/**/*",
      "assets/*.ico"
    ],
    "files": [
      "**/*",
      "!dist/**/*",
      "!실행하기.bat",
      "!exe만들기.bat"
    ]
  },
  "keywords": [
    "chiikawa",
    "kurimanju",
    "shimeji",
    "timer",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}